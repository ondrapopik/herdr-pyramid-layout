{
  "id": "pyramid-root", "type": "column", "titlebar": "none", "preview": "layouts/pyramid.svg", "theme": "graphite",
  "font_size": 13, "ui_font": "Geist", "background": "#4a3218",
  "colors": { "background": "#1f1a14", "accent": "#e0b04a", "border": "#4a3218" },
  "terminal_padding": [10, 12], "resizable": false,
  "children": [
    { "id": "pyramid-site", "type": "block", "size": { "weight": 1.15 }, "window_drag": true, "content": { "mod": "pyramid" } },
    { "id": "pyramid-rail", "type": "block", "size": { "px": 28 }, "content": { "mod": "pyramid", "props": { "role": "rail" } } },
    { "id": "pyramid-quarry", "type": "block", "size": { "weight": 1 }, "padding": [0, 10], "background": "#4a3218",
      "content": { "tab": "active", "pane": { "gap": 10, "radius": 0, "lone": true, "background": "#1f1a14",
        "border": { "width": 4, "color": "#2e2010" }, "focus": { "width": 4, "color": "#e0b04a" },
        "header": { "content": { "mod": "pyramid", "props": { "role": "pane" } }, "height": 26, "position": "top", "reveal": "always" }
      } }
    }
  ]
}
